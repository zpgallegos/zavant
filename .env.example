# Copy this file to .env. Make and the scripts under scripts/ load it automatically.

# Local application
ZAVANT_DATA_DIR=.local/lake
ZAVANT_MLB_API_BASE_URL=https://statsapi.mlb.com

# AWS deployment target
ZAVANT_AWS_ACCOUNT_ID=replace-with-12-digit-account-id
ZAVANT_AWS_REGION=us-east-1
ZAVANT_DEPLOYMENT_ENVIRONMENT=prod

# S3 access for local commands; AWS credentials use the normal SDK/CLI chain.
ZAVANT_S3_BUCKET=replace-with-AcquisitionBucketName-output
ZAVANT_S3_PREFIX=lake

# Acquisition bootstrap boundaries
ZAVANT_INITIAL_SCHEDULE_DATE=replace-with-YYYY-MM-DD
ZAVANT_INITIAL_CORRECTION_WATERMARK=replace-with-UTC-timestamp

# Daily workflow schedule
ZAVANT_DAILY_SCHEDULE_EXPRESSION='cron(0 6 * * ? *)'
ZAVANT_DAILY_SCHEDULE_TIMEZONE=America/Los_Angeles
ZAVANT_DAILY_SCHEDULE_STATE=ENABLED

# Analytical projection
ZAVANT_ANALYTICAL_ATHENA_WORKGROUP=primary
ZAVANT_ANALYTICAL_MAX_PROJECTION_PARTITIONS=64

# Hex warehouse integration. Add the principal and external ID after Hex
# generates its IAM trust policy for the draft Athena connection.
ZAVANT_HEX_DATABASE=zavant_dbt_prod
ZAVANT_HEX_QUERY_RESULT_RETENTION_DAYS=7
ZAVANT_HEX_BYTES_SCANNED_CUTOFF=1073741824
ZAVANT_HEX_AWS_PRINCIPAL_ARN=
ZAVANT_HEX_AWS_EXTERNAL_ID=
