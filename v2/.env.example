# Environment variable reference. Export overrides in your shell or task runner.
ZAVANT_DATA_DIR=.local/lake
ZAVANT_MLB_API_BASE_URL=https://statsapi.mlb.com

# Required by the Lambda entry point. Credentials come from its IAM role.
ZAVANT_S3_BUCKET=replace-with-AcquisitionBucketName-output
ZAVANT_S3_PREFIX=lake
ZAVANT_INITIAL_SCHEDULE_DATE=2026-08-03
ZAVANT_INITIAL_CORRECTION_WATERMARK=2026-08-03T00:00:00Z
